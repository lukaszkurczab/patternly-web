{
  "hosting": {
    "site": "patternly-app-sandbox",
    "public": "dist",
    "cleanUrls": true,
    "trailingSlash": false,
    "redirects": [
      { "source": "/admin/", "destination": "/admin", "type": 301 },
      { "source": "/admin.html", "destination": "/admin", "type": 301 }
    ],
    "rewrites": [
      { "source": "/privacy-request", "destination": "/index.html" },
      { "source": "/privacy-request/**", "destination": "/index.html" }
    ],
    "headers": [
      {
        "source": "/admin",
        "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
      }
    ]
  }
}
