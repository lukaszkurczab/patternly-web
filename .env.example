# Public Firebase web configuration and the HTTPS API origin. These are embedded at build time.
# Changing any value requires a new web build; do not add Firebase service-account credentials here.
VITE_ADMIN_FIREBASE_API_KEY=
VITE_ADMIN_FIREBASE_AUTH_DOMAIN=
VITE_ADMIN_FIREBASE_PROJECT_ID=
VITE_ADMIN_FIREBASE_APP_ID=
VITE_ADMIN_API_ORIGIN=
